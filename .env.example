# Copy to .env and edit. Never commit .env.

# Host port the gateway listens on. Loopback only.
WB2API_PORT=8788

# Upstream image tag. Pin a version for reproducible installs.
WB2API_TAG=latest

# Leave empty to let the gateway generate a key on first start.
WB2API_API_KEY=

# Container timezone. Keep UTC unless the account daily tasks need local time.
TZ=UTC

# Run the container as your own user. `id -u` and `id -g` on the host.
PUID=1000
PGID=1000
